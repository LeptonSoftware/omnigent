# Copied to .env next to docker-compose.yaml. Every replica reads the same file.
# Compose's `environment:` block still forces HOST/PORT/ARTIFACT_DIR,
# OMNIGENT_HOST_SHARDED=1 and the per-replica OMNIGENT_DISABLE_SCHEDULER.

OMNIGENT_IMAGE=asia-south2-docker.pkg.dev/rio-platform/docker/omnigent-server
# Pin a commit tag built with --build-arg VITE_OMNIGENT_HOST_ROUTING=true.
OMNIGENT_IMAGE_TAG=

# External Postgres shared by every replica (the server reads DATABASE_URL).
DATABASE_URL=postgresql+psycopg://omnigent:CHANGE_ME@db-host:5432/omnigent

# Auth: identical on every replica. Set the cookie secret explicitly
# (openssl rand -hex 32) so replicas never race to generate one on first boot.
OMNIGENT_AUTH_PROVIDER=
OMNIGENT_ACCOUNTS_COOKIE_SECRET=
OMNIGENT_ACCOUNTS_BASE_URL=

# Router listen address.
OMNIGENT_ROUTER_BIND=0.0.0.0
OMNIGENT_ROUTER_PORT=8000
